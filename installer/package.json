{
  "name": "apex-slicer-installer",
  "version": "0.0.0",
  "private": true,
  "author": "Aelox Hardware",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node run-electron.cjs",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.aeloxhardware.apexslicer.installer",
    "productName": "Installateur Apex Slicer",
    "copyright": "Copyright © Aelox Hardware",
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "executableName": "apex_installer",
      "icon": "../public/mini-logo.png",
      "requestedExecutionLevel": "requireAdministrator",
      "legalTrademarks": "Aelox Hardware",
      "target": [
        {
          "target": "portable"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.80"
  }
}
