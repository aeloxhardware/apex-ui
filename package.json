{
  "name": "vite_react_shadcn_ts",
  "version": "0.2.3",
  "apexVersion": "alpha-0.2.3.1.3.14.0.221",
  "packageManager": "pnpm@10.28.0",
  "apexUpdate": { "repo": "aeloxhardware/apex", "channel": "release" },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:lab-node": "vite --config vite.lab.config.ts",
    "dev:lab-assistant": "vite --config vite.lab-assistant.config.ts",
    "schema:sync": "node scripts/sync-engine-schema.cjs",
    "schema:check": "node scripts/sync-engine-schema.cjs --check",
    "schema:verify": "node scripts/sync-engine-schema.cjs --verify",
    "vectors:sync": "node scripts/sync-engine-vectors.cjs",
    "vectors:check": "node scripts/sync-engine-vectors.cjs --check",
    "test": "vitest run",
    "test:kinematics": "node scripts/check-kinematics-vectors.cjs",
    "build": "node scripts/sync-engine-schema.cjs --verify && vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . && node scripts/check-limits.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on http://localhost:8080 && cross-env ELECTRON_START_URL=http://localhost:8080 node scripts/run-electron.cjs\"",
    "python:fetch": "node scripts/fetch-python-embed.cjs",
    "electron:build": "node scripts/sync-engine-schema.cjs --verify && vite build && node scripts/fetch-python-embed.cjs && electron-builder",
    "electron:build:dir": "node scripts/sync-engine-schema.cjs --verify && vite build && node scripts/fetch-python-embed.cjs && electron-builder --dir",
    "limits:check": "node scripts/check-limits.cjs",
    "limits:update": "node scripts/check-limits.cjs --update",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@swc/core-win32-x64-msvc": "^1.16.0",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.56.2",
    "@yogesharc/thinking-orbs": "^0.1.2",
    "babylonjs": "^9.15.0",
    "babylonjs-loaders": "^9.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "country-flag-emoji-polyfill": "^0.1.10",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "framer-motion": "^13.1.0",
    "input-otp": "^1.2.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.4.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.12.7",
    "sass": "^1.101.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.aeloxhardware.apexslicer",
    "productName": "Apex Slicer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "profiles",
        "to": "profiles"
      },
      {
        "from": "native/data/head-samples.bin",
        "to": "native/head-samples.bin"
      },
      {
        "from": "python",
        "to": "python-scripts",
        "filter": [
          "*.py"
        ]
      }
    ],
    "mac": {
      "icon": "public/mini-logo.png",
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "icon": "build/icon-256.png",
      "target": "nsis",
      "extraResources": [
        {
          "from": "build/python-embed",
          "to": "python"
        },
        {
          "from": "native/build/apex_edit.node",
          "to": "native/apex_edit.node"
        },
        {
          "from": "native/build/apex_gcode_to_polar.exe",
          "to": "native/apex_gcode_to_polar.exe"
        },
        {
          "from": "native/build/apex_backdrop.node",
          "to": "native/apex_backdrop.node"
        }
      ]
    },
    "linux": {
      "icon": "public/mini-logo.png",
      "target": "AppImage"
    }
  }
}
