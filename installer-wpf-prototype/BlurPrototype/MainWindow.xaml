<Window x:Class="BlurPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prototype flou"
        Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ResizeMode="NoResize">
    <!-- Le fond de la Grid racine reste Transparent : c'est ce qui laisse
         voir le flou Acrylic natif la ou aucun element ne le recouvre. -->
    <Grid Background="Transparent" Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Bloc 1 : opaque, masque le flou a cet endroit -->
            <Border Background="#CC0A0F1A" CornerRadius="16" Padding="20,14" Margin="0,0,0,12">
                <TextBlock Text="Bloc opaque (titre)"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#00F0FF"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Espace vide entre les deux blocs : Grid parent Transparent
                 reste visible ici -> flou natif visible a travers ce "trou". -->
            <Border Height="24" Background="Transparent"/>

            <!-- Bloc 2 : opaque lui aussi, mais distinct visuellement -->
            <Border Background="#CC0A0F1A" CornerRadius="16" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Bloc opaque (contenu)"
                               FontSize="13"
                               Foreground="#DDFFFFFF"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Entre les deux blocs : vrai flou visible"
                               FontSize="11"
                               Foreground="#8800F0FF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
